{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "🐛 Debug Backend Server",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceRoot}/backend/server.js",
      "cwd": "${workspaceRoot}/backend",
      "restart": true,
      "console": "integratedTerminal"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "🌐 Debug Frontend in Chrome",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceRoot}/frontend/src"
    }
  ]
}
